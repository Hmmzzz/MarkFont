#!/bin/sh

set -e

package_prefix='@MARKFONT_PACKAGE_PREFIX@'
helper="${package_prefix}/usr/libexec/fontmanagerd"

case "${1:-}" in
  configure)
    if [ ! -x "$helper" ]; then
      echo "MarkFont configuration helper is unavailable." >&2
      exit 70
    fi
    "$helper" package-configure
    ;;
  abort-remove)
    # A failed removal deliberately keeps disable-mount and all recovery data.
    # This prevents an EBUSY mapping from being reattached after the user
    # reboots before retrying package removal.
    ;;
esac

exit 0
