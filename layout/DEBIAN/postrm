#!/bin/sh

set -e

package_prefix='@MARKFONT_PACKAGE_PREFIX@'
engine_root="${package_prefix}/var/lib/fontmanager"
mirror_storage_root="${package_prefix}/bindfs"
mirror_system_root="${package_prefix}/bindfs/System"
mirror_library_root="${package_prefix}/bindfs/System/Library"
mirror_fonts_root="${package_prefix}/bindfs/System/Library/Fonts"
mirror_staging_root="${package_prefix}/bindfs/System/Library/.Fonts.fontmanager-staging"
mirror_private_frameworks_root="${package_prefix}/bindfs/System/Library/PrivateFrameworks"
mirror_fontservices_root="${package_prefix}/bindfs/System/Library/PrivateFrameworks/FontServices.framework"
mirror_coreprivate_root="${package_prefix}/bindfs/System/Library/PrivateFrameworks/FontServices.framework/CorePrivate"
mirror_coreprivate_staging_root="${package_prefix}/bindfs/System/Library/PrivateFrameworks/FontServices.framework/.CorePrivate.fontmanager-staging"
containers_root=/var/mobile/Containers/Data/Application

request_sileo_reload() {
  if [ -z "${SILEO:-}" ]; then
    return 0
  fi

  sileo_fd=
  sileo_version=
  read -r sileo_fd sileo_version <<EOF
${SILEO}
EOF
  case "$sileo_fd" in
    ''|*[!0-9]*) return 0 ;;
  esac
  case "$sileo_version" in
    ''|*[!0-9]*) return 0 ;;
  esac
  if [ "$sileo_version" -lt 1 ]; then
    return 0
  fi

  # Sileo maps finish:reload to its user-controlled Restart SpringBoard
  # action. A closed control fd must not turn successful cleanup into a
  # failed dpkg removal.
  printf '%s\n' 'finish:reload' 2>/dev/null >&"$sileo_fd" || true
}

remove_exact_tree() {
  case "$1" in
    "$engine_root"|\
    "$mirror_fonts_root"|\
    "$mirror_staging_root"|\
    "$mirror_coreprivate_root"|\
    "$mirror_coreprivate_staging_root"|\
    "/var/mobile/Library/Application Support/com.hmmzzz.fontmanager"|\
    /var/mobile/Library/Caches/com.hmmzzz.fontmanager|\
    /tmp/com.hmmzzz.fontmanager.font-imports|\
    /var/mobile/tmp/com.hmmzzz.fontmanager.font-imports|\
    "$containers_root"/*/Library/Application?Support/com.hmmzzz.fontmanager|\
    "$containers_root"/*/Library/Caches/com.hmmzzz.fontmanager|\
    "$containers_root"/*/tmp/com.hmmzzz.fontmanager.font-imports)
      ;;
    *)
      echo "MarkFont refused an unknown cleanup path: $1" >&2
      exit 70
      ;;
  esac

  if [ -L "$1" ]; then
    rm -f "$1"
  elif [ -e "$1" ]; then
    if [ ! -d "$1" ]; then
      echo "MarkFont cleanup path is not a directory: $1" >&2
      exit 70
    fi
    rm -rf "$1"
  fi
}

require_physical_mount_parent() {
  case "$1" in
    "$mirror_storage_root"|"$mirror_system_root"|"$mirror_library_root"|\
    "$mirror_private_frameworks_root"|"$mirror_fontservices_root")
      ;;
    *)
      echo "MarkFont refused an unknown mount storage parent: $1" >&2
      exit 70
      ;;
  esac

  if [ -L "$1" ]; then
    echo "MarkFont mount storage parent is a symbolic link: $1" >&2
    exit 70
  elif [ -e "$1" ] && [ ! -d "$1" ]; then
    echo "MarkFont mount storage parent is not a directory: $1" >&2
    exit 70
  fi
}

# Sandboxed rootless installs keep app data in a randomized container below
# /var/mobile/Containers/Data/Application instead of the fixed /var/mobile
# paths cleaned above. Scan every container for MarkFont-owned directories.
remove_app_container_data() {
  [ -d "$containers_root" ] || return 0
  for container in "$containers_root"/*; do
    [ -d "$container" ] || continue
    case "${container##*/}" in
      ''|*[!-0-9A-Fa-f]*)
        echo "MarkFont refused an unsafe data container: $container" >&2
        exit 70
        ;;
    esac
    remove_exact_tree "$container/Library/Application Support/com.hmmzzz.fontmanager"
    remove_exact_tree "$container/Library/Caches/com.hmmzzz.fontmanager"
    remove_exact_tree "$container/tmp/com.hmmzzz.fontmanager.font-imports"
    rm -f "$container/Library/Preferences/com.hmmzzz.fontmanager.plist"
  done
}

case "${1:-}" in
  remove|purge)
    engine_owned=0
    mirror_owned=0
    if [ -L "$engine_root" ]; then
      echo "MarkFont recovery root is unsafe; data cleanup stopped." >&2
      exit 70
    elif [ -e "$engine_root" ] && [ ! -d "$engine_root" ]; then
      echo "MarkFont recovery root is not a directory; data cleanup stopped." >&2
      exit 70
    elif [ -L "$engine_root/.package-removal-ready" ]; then
      echo "MarkFont removal marker is unsafe; data cleanup stopped." >&2
      exit 70
    elif [ -f "$engine_root/.package-removal-ready" ]; then
      engine_owned=1
    elif [ -e "$engine_root" ]; then
      echo "MarkFont recovery data lacks a verified removal marker." >&2
      exit 70
    fi

    if [ "$engine_owned" -eq 1 ]; then
      if [ -L "$engine_root/.mirror-owned" ]; then
        echo "MarkFont mirror ownership marker is unsafe; managed mirror cleanup stopped." >&2
        exit 70
      elif [ -f "$engine_root/.mirror-owned" ]; then
        mirror_owned=1
      elif [ -e "$engine_root/.mirror-owned" ]; then
        echo "MarkFont mirror ownership marker is not a file; managed mirror cleanup stopped." >&2
        exit 70
      fi
    fi

    if [ "$engine_owned" -eq 1 ] && [ "$mirror_owned" -eq 1 ]; then
      require_physical_mount_parent "$mirror_storage_root"
      require_physical_mount_parent "$mirror_system_root"
      require_physical_mount_parent "$mirror_library_root"
      require_physical_mount_parent "$mirror_private_frameworks_root"
      require_physical_mount_parent "$mirror_fontservices_root"
      remove_exact_tree "$mirror_staging_root"
      remove_exact_tree "$mirror_fonts_root"
      remove_exact_tree "$mirror_coreprivate_staging_root"
      remove_exact_tree "$mirror_coreprivate_root"
      rmdir "$mirror_fontservices_root" 2>/dev/null || true
      rmdir "$mirror_private_frameworks_root" 2>/dev/null || true
      rmdir "$mirror_library_root" 2>/dev/null || true
      rmdir "$mirror_system_root" 2>/dev/null || true
    fi

    remove_exact_tree "/var/mobile/Library/Application Support/com.hmmzzz.fontmanager"
    remove_exact_tree /var/mobile/Library/Caches/com.hmmzzz.fontmanager
    remove_exact_tree /tmp/com.hmmzzz.fontmanager.font-imports
    remove_exact_tree /var/mobile/tmp/com.hmmzzz.fontmanager.font-imports
    rm -f /var/mobile/Library/Preferences/com.hmmzzz.fontmanager.plist
    remove_app_container_data

    if [ "$engine_owned" -eq 1 ]; then
      remove_exact_tree "$engine_root"
    fi
    request_sileo_reload
    ;;
  upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    # Never delete runtime data from an upgrade or dpkg error unwind.
    ;;
esac

exit 0
