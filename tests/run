#!/usr/bin/env bash

set -euo pipefail

test_script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
font_manager_root=$(CDPATH= cd -- "$test_script_dir/.." && pwd)
workspace_root=$(CDPATH= cd -- "$font_manager_root/../.." && pwd)

if [[ ${MARKFONT_LOCAL_TEST_ENV_READY:-0} != 1 ]]; then
  export MARKFONT_LOCAL_TEST_ENV_READY=1
  exec "$workspace_root/scripts/jb-env" "$0" "$@"
fi

test_build_dir=$(mktemp -d /tmp/markfont-core-tests.XXXXXX)

cleanup() {
  if [[ "$test_build_dir" == /tmp/markfont-core-tests.* && -d "$test_build_dir" ]]; then
    find "$test_build_dir" -depth -delete
  fi
}
trap cleanup EXIT INT TERM

xcrun clang \
  -fobjc-arc \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMStatusContract.m" \
  "$font_manager_root/tests/status-contract/main.m" \
  -o "$test_build_dir/status-contract-test"

"$test_build_dir/status-contract-test"

xcrun clang \
  -fobjc-arc \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMAutomaticRespringPolicy.m" \
  "$font_manager_root/tests/automatic-respring-policy/main.m" \
  -o "$test_build_dir/automatic-respring-policy-test"

"$test_build_dir/automatic-respring-policy-test"

xcrun clang \
  -fobjc-arc \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMRestartRequest.m" \
  "$font_manager_root/tests/restart-request/main.m" \
  -o "$test_build_dir/restart-request-test"

"$test_build_dir/restart-request-test"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFileStore.m" \
  "$font_manager_root/shared/FMTreeManifest.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMProfileEngine.m" \
  "$font_manager_root/tests/data-core/main.m" \
  -o "$test_build_dir/data-core-test"

"$test_build_dir/data-core-test" "$test_build_dir/fixture"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMSystemFontLayout.m" \
  "$font_manager_root/tests/font-catalog/main.m" \
  -o "$test_build_dir/font-catalog-test"

"$test_build_dir/font-catalog-test"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMFontPackageMatcher.m" \
  "$font_manager_root/tests/font-package-matcher/main.m" \
  -o "$test_build_dir/font-package-matcher-test"

"$test_build_dir/font-package-matcher-test"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -framework CoreText \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFileStore.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMFontPackageContentRefinement.m" \
  "$font_manager_root/shared/FMFontPackageMatcher.m" \
  "$font_manager_root/shared/FMFontPackageAnalyzer.m" \
  "$font_manager_root/shared/FMFontPackageImportSession.m" \
  "$font_manager_root/shared/FMFontProfileStore.m" \
  "$font_manager_root/tests/font-package-analyzer/main.m" \
  -o "$test_build_dir/font-package-analyzer-test"

"$test_build_dir/font-package-analyzer-test"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMFontSlotCatalog.m" \
  "$font_manager_root/tests/font-slot-catalog/main.m" \
  -o "$test_build_dir/font-slot-catalog-test"

"$test_build_dir/font-slot-catalog-test"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -framework CoreText \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFileStore.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMFontPackageContentRefinement.m" \
  "$font_manager_root/shared/FMFontPackageMatcher.m" \
  "$font_manager_root/shared/FMFontPackageAnalyzer.m" \
  "$font_manager_root/shared/FMFontProfileStore.m" \
  "$font_manager_root/shared/FMFontSlotCatalog.m" \
  "$font_manager_root/shared/FMMixFontProfile.m" \
  "$font_manager_root/shared/FMProfileAdoptionValidator.m" \
  "$font_manager_root/tests/mix-font-profile/main.m" \
  -o "$test_build_dir/mix-font-profile-test"

"$test_build_dir/mix-font-profile-test"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFileStore.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMProfileAdoptionValidator.m" \
  "$font_manager_root/tests/profile-adoption-validator/main.m" \
  -o "$test_build_dir/profile-adoption-validator-test"

"$test_build_dir/profile-adoption-validator-test" \
  "$test_build_dir/profile-adoption-validator-fixture"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFileStore.m" \
  "$font_manager_root/shared/FMTreeManifest.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMProfileAdoptionValidator.m" \
  "$font_manager_root/shared/FMLegacyFontProfileImport.m" \
  "$font_manager_root/tests/legacy-font-profile-import/main.m" \
  -o "$test_build_dir/legacy-font-profile-import-test"

"$test_build_dir/legacy-font-profile-import-test" \
  "$test_build_dir/legacy-font-profile-import-fixture"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFileStore.m" \
  "$font_manager_root/shared/FMTreeManifest.m" \
  "$font_manager_root/shared/FMFontCatalog.m" \
  "$font_manager_root/shared/FMProfileEngine.m" \
  "$font_manager_root/shared/FMProfileAdoptionValidator.m" \
  "$font_manager_root/shared/FMProfileAdoption.m" \
  "$font_manager_root/shared/FMProfileMirrorMatcher.m" \
  "$font_manager_root/shared/FMProfileStagePlanner.m" \
  "$font_manager_root/tests/profile-activation-pipeline/main.m" \
  -o "$test_build_dir/profile-activation-pipeline-test"

"$test_build_dir/profile-activation-pipeline-test" \
  "$test_build_dir/profile-activation-pipeline-fixture"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMDataModel.m" \
  "$font_manager_root/shared/FMFileStore.m" \
  "$font_manager_root/shared/FMTreeManifest.m" \
  "$font_manager_root/shared/FMMirrorPreparation.m" \
  "$font_manager_root/tests/mirror-preparation/main.m" \
  -o "$test_build_dir/mirror-preparation-test"

"$test_build_dir/mirror-preparation-test" "$test_build_dir/mirror-fixture"

xcrun clang \
  -fobjc-arc \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMSecureDirectory.m" \
  "$font_manager_root/tests/secure-directory/main.m" \
  -o "$test_build_dir/secure-directory-test"

"$test_build_dir/secure-directory-test" "$test_build_dir/secure-directory-fixture"

xcrun clang \
  -fobjc-arc \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMOperationLock.m" \
  "$font_manager_root/tests/operation-lock/main.m" \
  -o "$test_build_dir/operation-lock-test"

"$test_build_dir/operation-lock-test" "$test_build_dir/operation-lock-fixture"

xcrun clang \
  -fobjc-arc \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMMountBackendCompatibility.m" \
  "$font_manager_root/tests/provider-compatibility/main.m" \
  -o "$test_build_dir/provider-compatibility-test"

"$test_build_dir/provider-compatibility-test"

xcrun clang \
  -fobjc-arc \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  "$font_manager_root/shared/FMLegacyProviderAutoMountPolicy.m" \
  "$font_manager_root/tests/provider-auto-mount-policy/main.m" \
  -o "$test_build_dir/provider-auto-mount-policy-test"

"$test_build_dir/provider-auto-mount-policy-test"

xcrun clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -framework Foundation \
  -I "$font_manager_root/shared" \
  -I "$font_manager_root/tests/Fixtures" \
  "$font_manager_root/shared/FMMountBackendCompatibility.m" \
  "$font_manager_root/shared/FMMountCoordinator.m" \
  "$font_manager_root/tests/Fixtures/FMCoordinatorFixtures.m" \
  "$font_manager_root/tests/provider-coordinator/main.m" \
  -o "$test_build_dir/provider-coordinator-test"

"$test_build_dir/provider-coordinator-test"

if rg -n -g '*.m' 'MNT_FORCE|\bmount[[:space:]]*\(|\bunmount[[:space:]]*\(' \
    "$font_manager_root/app" \
    "$font_manager_root/daemon" \
    "$font_manager_root/cli" \
    "$font_manager_root/shared"; then
  printf 'FAIL: a mount syscall escaped the isolated MarkFont backend.\n' >&2
  exit 1
fi

if rg -n 'mount_bindfs|--skip-copy|/usr/bin/dash|/\.bindfs' \
    "$font_manager_root/app" \
    "$font_manager_root/daemon" \
    "$font_manager_root/cli" \
    "$font_manager_root/shared" \
    "$font_manager_root/bindfs"; then
  printf 'FAIL: an external Provider command or alias remains in runtime code.\n' >&2
  exit 1
fi

mount_backend_source="$font_manager_root/bindfs/main.m"
mount_backend_executor="$font_manager_root/shared/FMMountBackendExecutor.m"
if [[ $(rg -o '\bmount[[:space:]]*\(' "$mount_backend_source" | wc -l | tr -d ' ') != 1 ]] || \
   [[ $(rg -o '\bunmount[[:space:]]*\(' "$mount_backend_source" | wc -l | tr -d ' ') != 1 ]] || \
   [[ $(rg -o 'MNT_FORCE' "$mount_backend_source" | wc -l | tr -d ' ') != 1 ]] || \
   ! rg -q 'mount\("bindfs", targetPath\.fileSystemRepresentation, MNT_RDONLY' \
      "$mount_backend_source" || \
   ! rg -q 'unmount\(targetPath\.fileSystemRepresentation, MNT_FORCE\)' \
      "$mount_backend_source" || \
   ! rg -F -q 'FMSystemFontsPath = @"/System/Library/Fonts"' \
      "$mount_backend_source" || \
   ! rg -F -q 'FMFontsMirrorLogicalPath = @"/bindfs/System/Library/Fonts"' \
      "$mount_backend_source" || \
   ! rg -F -q 'FMFontServicesCorePrivatePath =' \
      "$mount_backend_source" || \
   ! rg -F -q '@"/System/Library/PrivateFrameworks/FontServices.framework/CorePrivate"' \
      "$mount_backend_source" || \
   ! rg -F -q 'FMFontServicesCorePrivateMirrorLogicalPath =' \
      "$mount_backend_source" || \
   ! rg -F -q '@"/bindfs/System/Library/PrivateFrameworks/FontServices.framework/CorePrivate"' \
      "$mount_backend_source" || \
   ! rg -q 'fputs\("markfont-bindfs 2\\n"' "$mount_backend_source" || \
   ! rg -q 'jbclient_root_steal_ucred' "$mount_backend_source" || \
   ! rg -q 'FMMappingIsExact' "$mount_backend_source" || \
   ! rg -q 'FMMountBackendProcessExitNotMounted' \
      "$font_manager_root/shared/FMMountBackendProtocol.h" || \
   ! rg -q 'FMMountBackendProcessExitNotMounted' "$mount_backend_source" || \
   ! rg -q 'FMMountBackendProcessExitNotMounted' "$mount_backend_executor" || \
   ! rg -q '@"detachWasRequired"' "$mount_backend_executor" || \
   ! rg -q 'argc != 2' "$mount_backend_source"; then
  printf 'FAIL: the built-in backend lost its fixed-path, read-only, exact-mapping boundary.\n' >&2
  exit 1
fi

system_font_layout_source="$font_manager_root/shared/FMSystemFontLayout.m"
supplemental_workspace_source="$font_manager_root/shared/FMDeviceSupplementalFontWorkspace.m"
if ! rg -q 'majorVersion >= 16 && majorVersion <= 17' \
      "$system_font_layout_source" || \
   ! rg -q 'majorVersion >= 18 && majorVersion <= 26' \
      "$system_font_layout_source" || \
   ! rg -q 'FMCurrentSystemFontLayout\(nil, nil\)' \
      "$mount_backend_source" || \
   ! rg -q 'FMSystemFontLayoutPrimaryFonts\) return mappings' \
      "$mount_backend_source" || \
   ! rg -q 'FMCurrentSystemFontLayout' \
      "$font_manager_root/shared/FMDeviceFontCatalog.m" || \
   ! rg -q 'FMCurrentSystemFontLayout' \
      "$supplemental_workspace_source" || \
   ! rg -q 'FMCurrentSystemFontLayout' \
      "$font_manager_root/shared/FMMountPaths.m" || \
   ! rg -q 'FMCurrentSystemFontLayout' \
      "$font_manager_root/shared/FMEnvironmentProbe.m" || \
   ! rg -q 'FMCurrentSystemFontLayout' \
      "$font_manager_root/shared/FMMountInspection.m" || \
   ! rg -q 'FMSystemFontLayoutPrimaryFonts' \
      "$supplemental_workspace_source" || \
   ! rg -q '@"status" : @"notRequired"' \
      "$supplemental_workspace_source"; then
  printf 'FAIL: system-version-first font layout or legacy single-mount boundary is missing.\n' >&2
  exit 1
fi

if rg -n 'FMFontCatalogPingFangUIRelativePath|compatibilityAlias|aliasApplied|selectedSourceFileName|compatibilityTargetByIgnoredSourceName|compatibilityAlternate|currentTargetFileName' \
      "$font_manager_root/shared" "$font_manager_root/app" || \
   rg -n 'PingFangUI\.ttc"\][[:space:]]*\?:' \
      "$font_manager_root/shared" "$font_manager_root/app" || \
   rg -n 'LanguageSupport/PingFangUI\.ttc|FontServicesCorePrivate/PingFang\.ttc' \
      "$font_manager_root/shared" "$font_manager_root/app"; then
  printf 'FAIL: an obsolete cross-name or wrong-path implementation remains.\n' >&2
  exit 1
fi

if ! rg -q 'FMRefineLegacyChineseTargetSelection' \
      "$font_manager_root/shared/FMFontPackageAnalyzer.m" || \
   ! rg -q 'FMContentSelectionProbeRelativePaths' \
      "$font_manager_root/shared/FMFontPackageAnalyzer.m" || \
   ! rg -qF 'FMFontContentSelectionReasonLegacyChinesePunctuationCompact' \
      "$font_manager_root/app/UI/FMFontLibraryViewController.m" || \
   ! rg -qF 'FMFontPackageContentRefinement.m' "$font_manager_root/app/Makefile" || \
   rg -n 'FMWrite|O_WRONLY|O_RDWR|rename|unlink|removeItem|mount_bindfs|posix_spawn|unmount' \
      "$font_manager_root/shared/FMFontPackageContentRefinement.m"; then
  printf 'FAIL: the legacy Chinese content-selection refinement is unwired or gained a write primitive.\n' >&2
  exit 1
fi

package_lifecycle_source="$font_manager_root/shared/FMDevicePackageLifecycle.m"
legacy_takeover_source="$font_manager_root/shared/FMDeviceLegacyFontTakeover.m"
legacy_profile_import_source="$font_manager_root/shared/FMLegacyFontProfileImport.m"
mount_engine_source="$font_manager_root/shared/FMDeviceMountEngine.m"
postinst="$font_manager_root/layout/DEBIAN/postinst"
prerm="$font_manager_root/layout/DEBIAN/prerm"
postrm="$font_manager_root/layout/DEBIAN/postrm"
unmount_count=$(rg -o '\bunmount[[:space:]]*\(' "$package_lifecycle_source" | \
  wc -l | tr -d ' ' || true)
if [[ "$unmount_count" != 0 ]] || \
   ! rg -q 'FMDetachManagedSystemFontsForPackageLifecycle' \
      "$package_lifecycle_source" || \
   rg -n 'MNT_FORCE|\bmount[[:space:]]*\(|\bunmount[[:space:]]*\(' \
      "$package_lifecycle_source" || \
   ! rg -q 'FMRefreshMountBackendForPreparedSystemFonts' \
      "$package_lifecycle_source" || \
   ! rg -q 'FMStageDeviceProfileWithExistingLock' \
      "$package_lifecycle_source" || \
   ! rg -q 'FMDevicePackageLifecycle\.m' "$font_manager_root/daemon/Makefile" || \
   ! rg -q 'fontmanagerd package-configure \[--json\]' \
      "$font_manager_root/daemon/main.m" || \
   ! rg -q 'fontmanagerd package-prepare-removal \[--json\]' \
      "$font_manager_root/daemon/main.m" || \
   ! rg -q 'FMOwnershipLogicalPath' "$package_lifecycle_source" || \
   ! rg -q 'FMPackageClaimEmptyInitialization' "$package_lifecycle_source" || \
   ! rg -q 'FMPackageMigrateBaselineIdentity' "$package_lifecycle_source" || \
   ! rg -q '@"baselineIdentityMigrated"' "$package_lifecycle_source" || \
   ! rg -q 'getuid\(\) != 0 \|\| geteuid\(\) != 0' \
      "$font_manager_root/daemon/main.m" || \
   rg -n 'wrapperSHA|mount_bindfs|--skip-copy' \
      "$package_lifecycle_source"; then
  printf 'FAIL: package lifecycle is not confined to the fixed root-only mount backend.\n' >&2
  exit 1
fi

legacy_unmount_count=$(rg -o '\bunmount[[:space:]]*\(' "$legacy_takeover_source" | \
  wc -l | tr -d ' ' || true)
if [[ "$legacy_unmount_count" != 0 ]] || \
   ! rg -q 'FMDetachManagedSystemFontsForPackageLifecycle' \
      "$legacy_takeover_source" || \
   rg -n 'MNT_FORCE|\bmount[[:space:]]*\(|\bunmount[[:space:]]*\(|FMRefreshMountBackendForPreparedSystemFonts|\.bak|LegacyFontBackups' \
      "$legacy_takeover_source" || \
   ! rg -q 'FMImportLegacyFontTreeAsProfile' "$legacy_takeover_source" || \
   ! rg -q 'removeItemAtPath:sourcePath' "$legacy_takeover_source" || \
   ! rg -q 'FMLegacyMirrorLogicalPath' "$legacy_takeover_source" || \
   ! rg -q 'FMDeviceMountTopology\.m' "$font_manager_root/daemon/Makefile" || \
   ! rg -q 'FMLegacyFontProfileImport\.m' "$font_manager_root/daemon/Makefile" || \
   ! rg -q 'FMDeviceLegacyFontTakeover\.m' "$font_manager_root/daemon/Makefile" || \
   ! rg -q 'ProfileLibrary' "$legacy_takeover_source" || \
   ! rg -q 'catalog\[@"files"\]' "$legacy_profile_import_source" || \
   ! rg -q 'FMIsSupportedFontCatalogRelativePath' \
      "$font_manager_root/shared/FMFontCatalog.m" || \
   rg -n 'Documents/MarkFont|LegacyFontBackups|\.bak' \
      "$legacy_takeover_source" "$legacy_profile_import_source" || \
   ! rg -q 'FMCompleteLegacyFontTakeover' "$package_lifecycle_source"; then
  printf 'FAIL: legacy font takeover lost its fixed backend-detach/Profile boundary.\n' >&2
  exit 1
fi

for maintainer_script in "$postinst" "$prerm" "$postrm"; do
  if [[ ! -x "$maintainer_script" ]] || ! /bin/sh -n "$maintainer_script"; then
    printf 'FAIL: package maintainer script is missing, non-executable, or invalid: %s\n' \
      "$maintainer_script" >&2
    exit 1
  fi
done

if ! rg -q "package_prefix='@MARKFONT_PACKAGE_PREFIX@'" "$postinst" "$prerm" "$postrm" || \
   ! rg -q '"\$helper" package-configure' "$postinst" || \
   ! rg -q '"\$helper" package-prepare-removal' "$prerm" || \
   ! rg -q '\.package-removal-ready' "$postrm" || \
   ! rg -q '\.mirror-owned' "$postrm" || \
   ! rg -q 'remove_exact_tree "\$mirror_fonts_root"' "$postrm" || \
   ! rg -q 'remove_exact_tree "\$mirror_staging_root"' "$postrm" || \
   ! rg -q 'remove_exact_tree "\$mirror_coreprivate_root"' "$postrm" || \
   ! rg -q 'remove_exact_tree "\$mirror_coreprivate_staging_root"' "$postrm" || \
   ! rg -q 'remove_exact_tree "\$engine_root"' "$postrm" || \
   ! rg -q 'require_physical_mount_parent "\$mirror_library_root"' "$postrm" || \
   ! rg -q 'remove_app_container_data' "$postrm" || \
   ! rg -q 'Containers/Data/Application' "$postrm" || \
   ! rg -q 'Application Support/com\.hmmzzz\.fontmanager' "$postrm" || \
   ! rg -q '^request_sileo_reload\(\)' "$postrm" || \
   ! rg -q "'finish:reload'" "$postrm" || \
   ! rg -q '^    request_sileo_reload$' "$postrm" || \
   ! rg -q 'upgrade\|failed-upgrade\|abort-install\|abort-upgrade\|disappear' "$postrm" || \
   rg -n '/var/jb|/private/preboot/|/\.bindfs|com\.nan\.auto-bindfs|MNT_FORCE|mount_bindfs[[:space:]]+-u|/usr/bin/sbreload' \
      "$postinst" "$prerm" "$postrm"; then
  printf 'FAIL: package scripts lost their exact cleanup or Sileo reload boundary.\n' >&2
  exit 1
fi

if ! rg -q 'FMRequireFreshOrReusableMountStorage' "$mount_engine_source" || \
   ! rg -q 'FMRequireSecureSharedMountRoot' "$mount_engine_source" || \
   ! rg -q 'O_RDONLY \| O_DIRECTORY \| O_NOFOLLOW \| O_CLOEXEC' \
      "$mount_engine_source" || \
   ! rg -q '@"mountStorageReused"' "$mount_engine_source" || \
   rg -q '/\.bindfs|FMValidateProviderAlias' "$mount_engine_source" || \
   rg -q 'readdir|fdopendir' "$mount_engine_source"; then
